{
    "name": "react-dsfr-tiptap-monorepo",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "examples",
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build -w packages/react-dsfr-tiptap",
        "build:examples": "npm run build:pages --w examples",
        "test": "npm run test -w packages/react-dsfr-tiptap",
        "examples": "npm run dev -w examples",
        "prepare": "husky",
        "lint": "oxlint --report-unused-disable-directives",
        "lint:fix": "oxlint --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "check-types": "npm run check-types --ws"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2006",
        "prettier": "^3.4.2",
        "typescript": "~5.9.0"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "lint-staged": {
        "*": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern",
        "*.{js,ts,jsx,tsx}": "oxlint"
    }
}
